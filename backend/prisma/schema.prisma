// Prisma Schema for Payment Collection Management System
// MySQL / MariaDB Database Config

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  password_hash String
  name          String
  role          String        // ADMIN | SALESMAN
  salesman_code String?
  mobile        String?
  email         String?
  fcm_token     String?       @db.Text
  status        String        @default("ACTIVE")
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  createdFollowups Followup[]
  createdPayments  Payment[]
  whatsappLogs     WhatsappLog[]
  refreshTokens    RefreshToken[]

  @@index([role])
  @@index([salesman_code])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token_hash String   @unique        // SHA-256 hash of the actual token
  user_id    Int
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())
  ip_address String?
  user_agent String?  @db.Text

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([revoked])
  @@map("refresh_tokens")
}

model Customer {
  id               Int           @id @default(autoincrement())
  customer_code    String        @unique
  customer_name    String
  alias            String?
  address          String?       @db.Text
  city             String?
  state            String?
  gstin            String?
  contact_person   String?
  mobile           String?
  alternate_mobile String?
  email            String?
  salesman_code    String?
  credit_limit     Float         @default(0)
  credit_days      Int           @default(0)
  status           String        @default("ACTIVE")
  current_status   String        @default("CURRENT") // CURRENT, DUE_TOMORROW, DUE_TODAY, OVERDUE_1_7, OVERDUE_8_30, PROMISE_DUE, BROKEN_PROMISE, DISPUTE, LEGAL_REVIEW, CLOSED
  escalation_level String        @default("L0")      // L0, L1, L2, L3, L4
  rcs_score        Float         @default(100)       // 0 to 100 Recovery Commitment Score
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  followups    Followup[]
  whatsappLogs WhatsappLog[]
  promiseLogs  PromiseLog[]

  @@index([customer_code])
  @@index([customer_name])
  @@index([salesman_code])
  @@index([mobile])
  @@index([status])
  @@index([current_status])
  @@index([escalation_level])
  @@map("customers")
}

model Invoice {
  id                  Int           @id @default(autoincrement())
  invoice_number      String        @unique
  invoice_date        DateTime
  customer_id         Int
  salesman_code       String?
  invoice_amount      Float
  paid_amount         Float         @default(0)
  outstanding_amount  Float
  due_date            DateTime
  source_voucher_code String?
  status              String        @default("NOT_DUE") // NOT_DUE, DUE_TODAY, OVERDUE, PARTIALLY_PAID, PAID
  imported_at         DateTime?     @default(now())
  updated_at          DateTime      @updatedAt

  customer  Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items     InvoiceItem[]
  payments  Payment[]
  followups Followup[]

  @@index([invoice_number])
  @@index([salesman_code])
  @@index([status])
  @@index([invoice_date])
  @@index([due_date])
  @@index([outstanding_amount])
  @@map("invoices")
}

model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  item_name  String
  hsn        String?
  quantity   Float
  unit       String?
  rate       Float
  discount   Float   @default(0)
  tax        Float   @default(0)
  amount     Float

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id               Int      @id @default(autoincrement())
  customer_id      Int
  invoice_id       Int?
  payment_date     DateTime
  amount           Float
  payment_mode     String   // Cash, Cheque, NEFT, RTGS, IMPS, UPI, Other
  reference_number String?
  bank             String?
  remark           String?  @db.Text
  created_by       Int?
  created_at       DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([payment_date])
  @@map("payments")
}

model Followup {
  id                     Int       @id @default(autoincrement())
  customer_id            Int
  invoice_id             Int?
  salesman_code          String?
  followup_date          DateTime
  followup_time          String?
  followup_type          String    // Phone Call, WhatsApp, Visit, Email, Payment Commitment, Payment Received, Other
  status                 String    @default("Pending") // Pending, Completed, Payment Promised, Payment Received, Customer Not Responding, Dispute, Postponed, Cancelled
  expected_payment_date  DateTime?
  expected_payment_amount Float?
  promise_to_pay_date    DateTime?
  promise_to_pay_amount  Float?
  remark                 String?   @db.Text
  next_followup_date     DateTime?
  next_followup_time     String?
  priority               String    @default("Medium") // Low, Medium, High, Urgent
  outcome                String?   @default("ANSWERED") // ANSWERED, NO_ANSWER, SWITCHED_OFF, BUSY
  spoke_with             String?
  reason_code_id         Int?
  channel                String?   @default("Phone Call") // Phone Call, WhatsApp, Visit, Email
  attachment             String?
  created_by             Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  customer    Customer     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice     Invoice?    @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [created_by], references: [id], onDelete: SetNull)
  promiseLogs PromiseLog[]

  @@index([salesman_code])
  @@index([followup_date])
  @@index([next_followup_date])
  @@index([status])
  @@map("followups")
}

model WhatsappLog {
  id          Int      @id @default(autoincrement())
  customer_id Int
  mobile      String
  message     String   @db.Text
  invoice_ids String?
  sent_by     Int?
  sent_at     DateTime @default(now())
  status      String   @default("SENT")

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [sent_by], references: [id], onDelete: SetNull)

  @@index([sent_at])
  @@map("whatsapp_logs")
}

model ImportLog {
  id                Int       @id @default(autoincrement())
  started_at        DateTime  @default(now())
  completed_at      DateTime?
  total_records     Int       @default(0)
  inserted_records  Int       @default(0)
  updated_records   Int       @default(0)
  failed_records    Int       @default(0)
  status            String    @default("RUNNING") // RUNNING, SUCCESS, FAILED
  error_message     String?   @db.Text

  @@map("import_logs")
}

model MssqlConfig {
  id                       Int      @id @default(1)
  host                     String   @default("localhost")
  port                     Int      @default(1433)
  database_name            String   @default("BUSY_ERP_DB")
  username                 String   @default("sa")
  password_encrypted       String   @default("")
  encrypt                  Boolean  @default(false)
  trust_server_certificate Boolean  @default(true)
  import_sql               String   @db.Text
  updated_at               DateTime @updatedAt

  @@map("mssql_configs")
}

model WhatsappTemplate {
  id         Int      @id @default(autoincrement())
  name       String   @unique // Payment Reminder, Payment Due, Payment Commitment, Custom
  content    String   @db.Text
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("whatsapp_templates")
}

model PromiseLog {
  id              Int       @id @default(autoincrement())
  customer_id     Int
  followup_id     Int?
  promised_amount Float
  promised_date   DateTime
  status          String    @default("PENDING") // PENDING, KEPT, BROKEN, PARTIAL
  kept_amount     Float     @default(0)
  broken_at       DateTime?
  created_by      Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  customer Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  followup Followup?  @relation(fields: [followup_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([promised_date])
  @@index([status])
  @@map("promise_logs")
}

model ReasonCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  category    String   // DISPUTE, DELAY, FINANCIAL, OPERATIONAL
  label       String
  description String?
  created_at  DateTime @default(now())

  @@map("reason_codes")
}
